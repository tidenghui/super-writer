# 复制成 .env.local 后填入真实值
# 注意：.env.local 已在 .gitignore 里，不会进版本库

# —— 站点 ——
# 影响 RSS、sitemap 里的绝对链接，以及页面上的品牌名
SITE_URL=https://tidenghui.com
SITE_NAME=提灯会
SITE_TAGLINE=每晚，多一盏灯。

# —— DeepSeek ——
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# —— 可选：第二个厂商，用来让批评家和写手不同源 ——
# 强烈建议配一个。同一个模型审自己的稿，盲区完全重合。
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# —— 预算护栏 ——
SW_MAX_CHAPTER_COST_CNY=15
