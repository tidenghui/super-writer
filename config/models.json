{
  "_doc": "角色 → 模型的路由表。改这里就能换模型，不用动代码。",
  "providers": {
    "deepseek": {
      "protocol": "openai",
      "baseUrl": "https://api.deepseek.com",
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "moonshot": {
      "protocol": "openai",
      "baseUrl": "https://api.moonshot.cn/v1",
      "apiKeyEnv": "MOONSHOT_API_KEY"
    },
    "openai": {
      "protocol": "openai",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY"
    }
  },
  "pricingCnyPerMTok": {
    "deepseek-chat": {
      "in": 2,
      "out": 8
    },
    "deepseek-reasoner": {
      "in": 4,
      "out": 16
    },
    "moonshot-v1-32k": {
      "in": 24,
      "out": 24
    },
    "gpt-6.1-sol": {
      "in": 14.4,
      "out": 72
    },
    "gpt-6-luna": {
      "in": 0.72,
      "out": 3.6
    }
  },
  "roles": {
    "showrunner": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 0.9
    },
    "planner": {
      "provider": "deepseek",
      "model": "deepseek-reasoner",
      "temperature": 0.9
    },
    "opener": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 1.1
    },
    "writer": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 0.95
    },
    "reviser": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 0.5
    },
    "critic": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 0.2
    },
    "coldReader": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 0.8
    },
    "auditor": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "reasoningEffort": "low"
    },
    "canonRecorder": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 0.1
    },
    "summarizer": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "temperature": 0.2
    },
    "outlineReview": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "reasoningEffort": "low"
    },
    "arbiter": {
      "provider": "openai",
      "model": "gpt-6.1-sol",
      "reasoningEffort": "low"
    },
    "coldReaderStrict": {
      "provider": "openai",
      "model": "gpt-6-luna",
      "reasoningEffort": "low"
    }
  },
  "_note": "reasoningEffort 只对 openai 生效。DeepSeek 传这个参数反而会开启推理，别加。"
}
