# 把 example.com 换成你的域名。
# Caddy 会自动申请并续期 Let's Encrypt 证书——前提是域名已经解析到这台机器的公网 IP，
# 且 80 / 443 端口没有被占用。

example.com {
	encode zstd gzip

	# 安全响应头。这个站是只读的，没有登录也没有表单。
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# 静态样式：可以长缓存
	@static path /static/*
	header @static Cache-Control "public, max-age=86400"

	# 订阅源与站点地图
	@feed path /feed.xml /sitemap.xml /robots.txt
	header @feed Cache-Control "public, max-age=300"

	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/super-writer.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# 如果先不绑域名，只想用 IP 试一下，把上面整段换成：
#
# :80 {
# 	reverse_proxy 127.0.0.1:8787
# }
